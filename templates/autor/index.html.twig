{% extends 'base.html.twig' %}

{% block body %}

    {{ include('partials/_crud_header.html.twig', {
        title: 'Autores',
        new_route: 'autor_novo',
        new_label: 'Novo Assunto'
    }) }}



{% embed 'partials/_table_layout.html.twig' %}

    {% block table_header %}
        <th>Código</th>
        <th>Nome</th>
        <th>Livros</th>
        <th>Ações</th>
    {% endblock %}

    {% block table_body %}

    {% for autor in autores %}
        <tr>

            <td>{{ autor.codau }}</td>

            <td>{{ autor.nome }}</td>

            <td>{{ autor.livros|length }}</td>

            <td>

                {{ include('partials/_table_actions.html.twig', {
                    show_route: 'autor_show',
                    edit_route: 'autor_editar',
                    delete_route: 'autor_remover',
                    route_params: {
                        codau: autor.codau
                    },
                    delete_token_id: 'delete' ~ autor.codau
                }) }}

            </td>

        </tr>
        {% else %}

            <tr>
                <td colspan="4">
                    Nenhum assunto encontrado.
                </td>
            </tr>

        {% endfor %}
    {% endblock %}
{% endembed %}

{{ include('partials/_paginacao.html.twig', {
    paginaAtual:        paginaAtual,
    totalPaginas:       totalPaginas,
    limiteAtual:        limiteAtual,
    limitesPermitidos:  limitesPermitidos,
    rota:               'autor_index',
    params:             {}
    }) 
}}

{% endblock %}