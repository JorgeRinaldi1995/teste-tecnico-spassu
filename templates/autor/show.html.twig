{% extends 'base.html.twig' %}

{% block body %}

{% include 'partials/_crud_header.html.twig' with {
    title: 'Detalhes do Autor',
    back_route: 'autor_index',
    edit_route: 'autor_edit',
    route_params: { codau: autor.codau }
} %}

<table class="table table-bordered">

    <tr>
        <th>Nome</th>
        <td>{{ autor.nome }}</td>
    </tr>

</table>

<h3>Livros deste autor</h3>

<ul>

    {% for livro in autor.livros %}
        <li>
            {{ livro.titulo }}
        </li>
    {% else %}
        <li>Nenhum livro cadastrado.</li>
    {% endfor %}

</ul>

<a href="{{ path('autor_index') }}"
   class="btn btn-secondary">
    Voltar
</a>

{% endblock %}