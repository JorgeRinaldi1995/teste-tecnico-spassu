{% extends 'base.html.twig' %}

{% block title %}Detalhes do Livro{% endblock %}

{% block body %}

    <h1>{{ livro.titulo }}</h1>

    <dl>
        <dt>Editora</dt>
        <dd>{{ livro.editora ?? '—' }}</dd>

        <dt>Edição</dt>
        <dd>{{ livro.edicao ?? '—' }}</dd>

        <dt>Ano de Publicação</dt>
        <dd>{{ livro.anoPublicacao ?? '—' }}</dd>

        <dt>Preço</dt>
        <dd><span>R$: </span>{{ livro.valor is not null ? livro.valor|number_format(2, ',', '.') : '—' }}</dd>
    </dl>
    <section>
        <h2>Autores</h2>

        {% if livro.autores is empty %}
            <p>Nenhum autor cadastrado.</p>
        {% else %}
            <ul>
                {% for autor in livro.autores %}
                    <li>{{ autor.nome }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
    <section>
        <h2>Assuntos</h2>

        {% if livro.assuntos is empty %}
            <p>Nenhum assunto cadastrado.</p>
        {% else %}
            <ul>
                {% for assunto in livro.assuntos %}
                    <li>{{ assunto.descricao }}</li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>
<a
    href="{{ path('livro_editar', {'codl': livro.codl}) }}"
    class="btn btn-warning"
>
    Editar
</a>

<a
    href="{{ path('livro_index') }}"
    class="btn btn-secondary"
>
    Voltar
</a>

{% endblock %}