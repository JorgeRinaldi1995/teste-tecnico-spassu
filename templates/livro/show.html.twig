{% extends 'base.html.twig' %}

{% block title %}Detalhes do Livro{% endblock %}

{% block body %}

<div class="container py-4">

    {% include 'partials/_crud_header.html.twig' with {
        title: 'Detalhes do Livro',
        back_route: 'livro_index',
        edit_route: 'livro_edit',
        route_params: { codl: livro.codl }
    } %}

    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h2 class="card-title mb-4 text-center text-md-start">
                        {{ livro.titulo }}
                    </h2>

                    <dl class="row mb-0">

                        <dt class="col-5 col-md-4">Editora</dt>
                        <dd class="col-7 col-md-8">
                            {{ livro.editora ?? '—' }}
                        </dd>

                        <dt class="col-5 col-md-4">Edição</dt>
                        <dd class="col-7 col-md-8">
                            {{ livro.edicao ?? '—' }}
                        </dd>

                        <dt class="col-5 col-md-4">Ano</dt>
                        <dd class="col-7 col-md-8">
                            {{ livro.anoPublicacao ?? '—' }}
                        </dd>

                        <dt class="col-5 col-md-4">Preço</dt>
                        <dd class="col-7 col-md-8">
                            {{ livro.valor is not null
                                ? 'R$ ' ~ livro.valor|number_format(2, ',', '.')
                                : '—'
                            }}
                        </dd>

                    </dl>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h3 class="h5 mb-3">Autores</h3>

                    {% if livro.autores is empty %}
                        <p class="text-muted mb-0">
                            Nenhum autor cadastrado.
                        </p>
                    {% else %}
                        <ul class="list-group">
                            {% for autor in livro.autores %}
                                <li class="list-group-item">
                                    {{ autor.nome }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">

                    <h3 class="h5 mb-3">Assuntos</h3>

                    {% if livro.assuntos is empty %}
                        <p class="text-muted mb-0">
                            Nenhum assunto cadastrado.
                        </p>
                    {% else %}
                        <ul class="list-group">
                            {% for assunto in livro.assuntos %}
                                <li class="list-group-item">
                                    {{ assunto.descricao }}
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                </div>
            </div>
        </div>
    </div>

</div>
<a
    href="{{ path('livro_editar', {'codl': livro.codl}) }}"
    class="btn btn-warning"
>
    Editar
</a>

<a
    href="{{ path('livro_index') }}"
    class="btn btn-secondary"
>
    Voltar
</a>

{% endblock %}