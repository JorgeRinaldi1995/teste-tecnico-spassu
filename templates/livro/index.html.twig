{% extends 'base.html.twig' %}

{% block body %}

    {{ include('partials/_crud_header.html.twig', {
        title: 'Livros',
        new_route: 'livro_novo',
        new_label: 'Novo Livro'
    }) }}

    {% embed 'partials/_table_layout.html.twig' %}

        {% block table_header %}
            <th>Código</th>
            <th>Título</th>
            <th>Editora</th>
            <th>Edição</th>
            <th>Ano</th>
            <th>Valor</th>
            <th width="220">Ações</th>
        {% endblock %}

    {% block table_body %}

    {% for livro in livros %}
        <tr>
            <td>{{ livro.codl }}</td>
            <td>{{ livro.titulo }}</td>
            <td>{{ livro.editora }}</td>
            <td>{{ livro.edicao }}</td>
            <td>{{ livro.anoPublicacao }}</td>
            <td>{{ livro.valor }}</td>
            <td>
                {{ include('partials/_table_actions.html.twig', {
                    show_route: 'livro_show',
                    edit_route: 'livro_editar',
                    delete_route: 'livro_remover',
                    route_params: {
                        codl: livro.codl
                    },
                    delete_token_id: 'delete' ~ livro.codl
                }) }}
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="4">
                Nenhum assunto encontrado.
            </td>
        </tr>
    {% endfor %}

        {% endblock %}

    {% endembed %}
{{ include('partials/_paginacao.html.twig', {
    paginaAtual:        paginaAtual,
    totalPaginas:       totalPaginas,
    limiteAtual:        limiteAtual,
    limitesPermitidos:  limitesPermitidos,
    rota:               'livro_index',
    params:             {}
    }) 
}}
{% endblock %}