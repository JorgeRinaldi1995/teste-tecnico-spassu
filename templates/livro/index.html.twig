{% extends 'base.html.twig' %}

{% block title %}Lista de Livros{% endblock %}

{% block body %}

<div class="d-flex justify-content-between mb-3">
    <h1>Livros</h1>

    <a href="{{ path('livro_novo') }}" class="btn btn-primary">
        Novo Livro
    </a>
</div>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Código</th>
            <th>Título</th>
            <th>Editora</th>
            <th>Edição</th>
            <th>Ano</th>
            <th width="220">Ações</th>
        </tr>
    </thead>
    <tbody>

    {% for livro in livros %}
        <tr>
            <td>{{ livro.codl }}</td>
            <td>{{ livro.titulo }}</td>
            <td>{{ livro.editora }}</td>
            <td>{{ livro.edicao }}</td>
            <td>{{ livro.anoPublicacao }}</td>
            <td>
                <a
                    href="{{ path('livro_show', {'codl': livro.codl}) }}"
                    class="btn btn-info btn-sm"
                >
                    Visualizar
                </a>

                <a
                    href="{{ path('livro_editar', {'codl': livro.codl}) }}"
                    class="btn btn-warning btn-sm"
                >
                    Editar
                </a>

                <form
                    action="{{ path('livro_remover', {'codl': livro.codl}) }}"
                    method="post"
                    class="d-inline"
                >
                    <button
                        type="submit"
                        class="btn btn-danger btn-sm"
                        onclick="return confirm('Deseja remover este livro?')"
                    >
                        Excluir
                    </button>
                </form>
            </td>
        </tr>
    {% else %}
        <tr>
            <td colspan="6" class="text-center">
                Nenhum livro encontrado.
            </td>
        </tr>
    {% endfor %}

    </tbody>
</table>

{% endblock %}