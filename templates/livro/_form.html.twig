{# _form.html.twig #}

{{ form_start(form) }}

{{ form_row(form.titulo) }}
{{ form_row(form.editora) }}
{{ form_row(form.edicao) }}
{{ form_row(form.anoPublicacao) }}
{{ form_row(form.valor) }}

<div class="mb-3">
    {{ form_label(form.autores) }}
    {{ form_widget(form.autores, {
        attr: {
            class: 'form-select'
        }
    }) }}
</div>

<div class="mb-3">
    {{ form_label(form.assuntos) }}
    {{ form_widget(form.assuntos, {
        attr: {
            class: 'form-select'
        }
    }) }}
</div>

<button class="btn btn-success">
    {{ button_label|default('Salvar') }}
</button>

{{ form_end(form) }}