<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="row w-100 justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">
            {{ form_start(form, {
                attr: {
                    class: 'p-4 border rounded bg-light shadow-sm'
                }
            }) }}

            <div class="col justify-content-center" >
                <div class="col">
                    {{ form_row(form.titulo) }}
                </div>

                <div class="col">
                    {{ form_row(form.editora) }}
                </div>

                <div class="col">
                    {{ form_row(form.edicao) }}
                </div>

                <div class="col">
                    {{ form_row(form.anoPublicacao) }}
                </div>

                <div class="col">
                    {{ form_row(form.valor) }}
                </div>
            </div>

            <div class="col">
                <div class="col">
                    {{ form_row(form.autores) }}
                </div>

                <div class="col">
                    {{ form_row(form.assuntos) }}
                </div>
            </div>

            <div class="mt-3">
                <button class="btn btn-success">
                    {{ button_label|default('Salvar') }}
                </button>
            </div>

            {{ form_end(form) }}

        </div>
    </div>
</div>