{% extends 'base.html.twig' %}

{% block body %}

    {{ include('partials/_crud_header.html.twig', {
        title: 'Assuntos',
        new_route: 'assunto_novo',
        new_label: 'Novo Assunto'
    }) }}

    {% embed 'partials/_table_layout.html.twig' %}

        {% block table_header %}
            <th>Código</th>
            <th>Descrição</th>
            <th>Livros</th>
            <th>Ações</th>
        {% endblock %}

        {% block table_body %}

            {% for assunto in assuntos %}

                <tr>

                    <td>{{ assunto.codas }}</td>

                    <td>{{ assunto.descricao }}</td>

                    <td>{{ assunto.livros|length }}</td>

                    <td>

                        {{ include('partials/_table_actions.html.twig', {
                            show_route: 'assunto_show',
                            edit_route: 'assunto_editar',
                            delete_route: 'assunto_remover',
                            route_params: {
                                codas: assunto.codas
                            },
                            delete_token_id: 'delete' ~ assunto.codas
                        }) }}

                    </td>

                </tr>

            {% else %}

                <tr>
                    <td colspan="4">
                        Nenhum assunto encontrado.
                    </td>
                </tr>

            {% endfor %}

        {% endblock %}

    {% endembed %}
{{ include('partials/_paginacao.html.twig', {
    paginaAtual:        paginaAtual,
    totalPaginas:       totalPaginas,
    limiteAtual:        limiteAtual,
    limitesPermitidos:  limitesPermitidos,
    rota:               'assunto_index',
    params:             {}
    }) 
}}

{% endblock %}