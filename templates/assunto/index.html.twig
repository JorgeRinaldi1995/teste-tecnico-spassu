{% extends 'base.html.twig' %}

{% block body %}

<div class="d-flex justify-content-between mb-3">

    <h1>Assuntos</h1>

    <a href="{{ path('assunto_novo') }}"
       class="btn btn-primary">
        Novo Assunto
    </a>

</div>

<table class="table table-striped">

    <thead>
        <tr>
            <th>Código</th>
            <th>Descrição</th>
            <th>Livros</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>

    {% for assunto in assuntos %}
        <tr>

            <td>{{ assunto.codas }}</td>

            <td>{{ assunto.descricao }}</td>

            <td>{{ assunto.livros|length }}</td>

            <td>

                <a href="{{ path('assunto_show', {'codas': assunto.codas}) }}"
                   class="btn btn-info btn-sm">
                    Ver
                </a>

                <a href="{{ path('assunto_editar', {'codas': assunto.codas}) }}"
                   class="btn btn-warning btn-sm">
                    Editar
                </a>

            </td>

        </tr>
    {% else %}
        <tr>
            <td colspan="4">
                Nenhum assunto encontrado.
            </td>
        </tr>
    {% endfor %}

    </tbody>

</table>

{% endblock %}