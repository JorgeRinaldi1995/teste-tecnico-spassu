<div class="container-fluid min-vh-100 d-flex align-items-top justify-content-center">
    <div class="row w-100 justify-content-center">
        

        {{ form_start(form, {
            attr: {
                class: 'library-form p-4 border rounded bg-light shadow-sm'
            }
        }) }}

        {% block form_fields %}
        {% endblock %}

        {{ include('partials/_form_actions.html.twig', {
            button_label: button_label|default('Salvar'),
            back_route: back_route|default(null)
        }) }}

        {{ form_end(form) }}


    </div>
</div>