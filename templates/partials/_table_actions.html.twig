<div class="btn-group">

    {% if show_route is defined %}
        <a href="{{ path(show_route, route_params) }}"
           class="btn btn-info btn-sm">
            Ver
        </a>
    {% endif %}

    {% if edit_route is defined %}
        <a href="{{ path(edit_route, route_params) }}"
           class="btn btn-warning btn-sm">
            Editar
        </a>
    {% endif %}

    {% if delete_route is defined %}
        <form method="post"
            action="{{ path(delete_route, route_params) }}"
            onsubmit="return confirm('Deseja realmente excluir este registro?');">

            <input type="hidden"
                name="_token"
                value="{{ csrf_token(delete_token_id) }}">

            <button class="btn btn-danger btn-sm">
                Excluir
            </button>
        </form>
    {% endif %}
</div>